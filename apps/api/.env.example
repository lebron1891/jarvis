# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# PostgreSQL connection string
DATABASE_URL=postgresql://skillswap:skillswap@localhost:5432/skillswap
# Origin of the web app (CORS + links in emails)
WEB_ORIGIN=http://localhost:3000
# Public URL of this API (used to build local upload URLs)
PUBLIC_API_URL=http://localhost:4000

# --- Auth (REQUIRED in production: set strong random secrets) ---------------
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# --- OAuth (optional) --------------------------------------------------------
# Google: create an OAuth client at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
# Apple: Services ID from https://developer.apple.com/account/resources/identifiers
APPLE_CLIENT_ID=

# --- AI assistant (optional — falls back to helpful stubs without a key) -----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# Free-plan daily AI request quota (premium users are unlimited)
AI_FREE_DAILY_LIMIT=5

# --- Email (optional — logs verification/reset links to console if unset) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SkillSwap <no-reply@skillswap.app>"

# --- File storage (optional S3-compatible: AWS S3, Cloudflare R2, MinIO…) ----
# Local disk (./uploads) is used when these are unset.
UPLOAD_DIR=uploads
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
